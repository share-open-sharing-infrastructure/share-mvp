# AllerLeih environment template — copy to .env and fill in real values.
# See docs/architecture.md (overview) and docs/operations/integration-sync.md (sync vars).

# PocketBase instance the app talks to (see allerleih-backend repo)
PUBLIC_PB_URL=http://localhost:8090

# Web Push (VAPID) — generate a key pair with: npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OpenRouteService — geocoding + travel times (https://openrouteservice.org)
ORS_API_KEY=

# Mistral AI — item photo analysis (prod only; optional in dev)
MISTRAL_API_KEY=

# Integration sync (/api/sync + /api/refresh) — see docs/operations/integration-sync.md.
# SYNC_SECRET must match the backend cron's SYNC_SECRET; the superuser account is used
# to read/write items across institutional accounts.
SYNC_SECRET=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Optional dev-server settings (see vite.config.ts)
# DEV_ALLOWED_HOST=
# DEV_DISABLE_MKCERT=true

# Instance configuration (multi-city) — see docs/architecture.md ("Instance configuration").
# Ungesetzt ⇒ Lüneburg-Defaults. Eine neue Stadt MUSS PUBLIC_SITE_ORIGIN und
# PUBLIC_INSTANCE_CITY setzen. Analytics ist opt-in: ohne PUBLIC_ANALYTICS_* werden keine
# Skripte geladen.
# PUBLIC_SITE_ORIGIN=https://allerleih.org
# PUBLIC_INSTANCE_CITY=Lüneburg
# PUBLIC_APP_NAME=AllerLeih
# PUBLIC_CONTACT_EMAIL=kontakt@allerleih.org
# PUBLIC_ANALYTICS_ORIGIN=
# PUBLIC_ANALYTICS_WEBSITE_ID=
