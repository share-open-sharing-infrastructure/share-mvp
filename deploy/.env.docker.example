# AllerLeih self-hosting stack — environment template (share-mvp#630).
#
# Copy to `.env` next to compose.yaml (`cp .env.docker.example .env`) and fill it in — BOTH the
# `backend` and `frontend` services in compose.yaml read this exact file (`env_file: - .env`),
# so it covers both repos' variables in one place. Neither container is confused by the other's
# vars: PocketBase only ever reads the names in allerleih-backend/pb_hooks/constants.js and
# silently ignores the rest, and the frontend's startup check
# (`src/lib/server/env.ts` → `assertRequiredEnv()`) only checks for its own required set.
#
# Every value here is read at RUNTIME by both images (frontend: issue #627's
# `$env/dynamic/*`; backend: `$os.getenv()` in pb_hooks/constants.js) — nothing is baked into
# either image at build time, so bumping an image tag never requires rebuilding to pick up a
# new value here. See docs/operations/self-hosting.md for the full first-run runbook this file
# supports, and the frontend's own .env.example / the backend's .claude/rules/config.md for the
# canonical, most detailed reference on each variable.
#
# Heads-up on `PUBLIC_*`: the frontend serialises the WHOLE `PUBLIC_*` environment into every
# rendered page (not just the vars a module reads) — treat any `PUBLIC_*` value here as fully
# public the moment it's set.

# ============================================================================================
# IMAGE TAGS — compose.yaml's own variable interpolation (separate mechanism from the env_file:
# lines above, but the SAME .env file — compose auto-loads it for this purpose too)
# ============================================================================================

# Pin (or roll back) a version instead of always running :latest — see
# docs/operations/self-hosting.md → "Updating" for why that matters before any upgrade. Find
# tags on each image's GHCR package page. Leaving both unset/commented keeps :latest.
# BACKEND_IMAGE_TAG=v1.2.3
# FRONTEND_IMAGE_TAG=v1.2.3

# ============================================================================================
# FRONTEND — required (the frontend container refuses to start if any of these is missing or
# empty; assertRequiredEnv() names every offender in its logs)
# ============================================================================================

# PocketBase's PUBLIC, reverse-proxied URL — e.g. https://pb.example.org/ — NEVER the
# compose-internal "http://backend:8090/". Read by BOTH the browser (client-side realtime +
# file URLs) and the frontend server's own PocketBase client, so it must be reachable from
# both. A trailing slash is added automatically if you omit it. See compose.yaml's header
# comment for why this can't be a Docker-internal address.
PUBLIC_PB_URL=https://pb.example.org/

# Web Push (VAPID) — generate your OWN key pair, do not reuse any example/CI value in
# production: npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OpenRouteService API key (https://openrouteservice.org) — used by BOTH containers: the
# frontend's /api/geocode (address autocomplete) and the backend's /api/travel-times. One key
# covers both; a wrong value degrades geocoding/travel-times to empty results rather than
# breaking anything else.
ORS_API_KEY=

# adapter-node: the exact scheme+host(+port) users type into their browser to reach the
# frontend, e.g. https://app.example.org (no trailing slash). REQUIRED in practice even though
# assertRequiredEnv() can't see it (it's an adapter-node knob, not an app var) — omit it and
# EVERY form action, including login, fails with "Cross-site POST form submissions are
# forbidden". See docs/architecture.md#running-the-official-container-image.
ORIGIN=https://app.example.org

# PocketBase superuser — read by the frontend at runtime for the /admin gate and the public
# stats/metrics_daily reads (src/lib/server/superuser.ts), AND used with the SAME values when
# you create the actual superuser account in step 2 of the runbook
# (`docker compose exec backend /app/pocketbase superuser upsert ...`). Full, unrestricted
# database access — treat like any other master secret.
PB_SUPERUSER_EMAIL=admin@example.org
PB_SUPERUSER_PASSWORD=

# ============================================================================================
# FRONTEND — optional
# ============================================================================================

# adapter-node's request-body size cap. The image already defaults this to 10485760 (10 MB) —
# only set it here to override that default.
# BODY_SIZE_LIMIT=10485760

# Mistral AI — item-photo analysis (/api/analyze-item). The ONLY optional app var: unset means
# that one endpoint answers 503 and nothing else changes.
MISTRAL_API_KEY=

# Instance branding (issue #473) — unset ⇒ the flagship "Lüneburg" defaults. A new instance
# SHOULD set at least PUBLIC_SITE_ORIGIN + PUBLIC_INSTANCE_CITY. See
# docs/architecture.md#instance-configuration-multi-city.
# PUBLIC_SITE_ORIGIN=https://app.example.org
# PUBLIC_INSTANCE_CITY=
# PUBLIC_APP_NAME=AllerLeih
# PUBLIC_CONTACT_EMAIL=kontakt@example.org
# PUBLIC_ANALYTICS_ORIGIN=
# PUBLIC_ANALYTICS_WEBSITE_ID=

# NOT YET CONFIGURABLE VIA ENV (share-mvp#629, open as of this writing): the §5-TMG imprint
# (operator name/address), the feedback email, and the social/project links are still hardcoded
# in src/lib/instance.ts to the flagship instance's own values. There is NO env var for them —
# do not invent one here. Until #629 ships, a self-hoster who needs their own imprint (legally
# mandatory for any public instance in Germany) must fork the frontend, edit that block, and
# build/publish their own image rather than run the stock ghcr.io/…/allerleih-frontend image
# unmodified. See docs/operations/self-hosting.md → "First run" step 5 for the current state of
# this gap.

# ============================================================================================
# BACKEND — practically required, or a feature goes silently dead (allerleih-backend has no
# frontend-style startup check; a missing value here just means that feature stays broken)
# ============================================================================================

# The frontend's public origin (no trailing slash) — injected into the `users` collection's
# auth-mail links (registration verification, password reset) and used as the APP_URL fallback
# below. Get this wrong and verification/reset emails link to the wrong host.
FRONTEND_URL=https://app.example.org

# The backend's OWN public origin (no trailing slash) — used for mail-logo/asset URLs and the
# digest-unsubscribe link (allerleih-backend/pb_hooks/utils/urls.js → assetBase()). Falls back
# to FRONTEND_URL if unset, but set it explicitly to avoid landing on PocketBase's own built-in
# "http://localhost:8090" default the one time SMTP is configured only via the admin UI.
APP_URL=https://pb.example.org

# SMTP — applied on backend bootstrap ONLY when SMTP_HOST is set (idempotent; leaving it empty
# leaves any existing admin-UI mail settings untouched). Without this, registration/verification
# mail, password resets and notification digests are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_TLS=true selects implicit TLS (port 465); false (default) selects STARTTLS (587).
SMTP_TLS=false
# SMTP_AUTH_METHOD=PLAIN
# SMTP_LOCAL_NAME=
# SENDER_ADDRESS=
# SENDER_NAME=

# ============================================================================================
# BACKEND — optional overrides (safe defaults exist in allerleih-backend/pb_hooks/constants.js;
# see allerleih-backend/.claude/rules/config.md for the full reference)
# ============================================================================================

# LOG_LEVEL=4              # 1=DEBUG … 4=ERROR
# DRY_MODE=false           # true suppresses outbound email + integration cron side effects
# MAIL_THROTTLE_MINUTES=15
# SYNC_CRON=               # institutional catalogue full-sync cron expression; empty = off
# REFRESH_CRON=            # institutional per-item refresh cron expression; empty = off
# RETENTION_INACTIVE_MONTHS=6
# RETENTION_MESSAGES_MONTHS=6
# RETENTION_NOTIFICATIONS_DAYS=90
# RETENTION_FEEDBACK_MONTHS=6
# RETENTION_INACTIVE_WARN_DAYS=30
# ADMIN_NOTIFY_EMAIL=
# UNSUBSCRIBE_SECRET=      # `openssl rand -hex 32` — set explicitly so rotating the auth-token
#                          # secret doesn't invalidate every digest-unsubscribe link already sent
# DIGEST_SENDER_ADDRESS=
# DIGEST_SENDER_NAME=

# NEVER SET IN PRODUCTION — each opens a guarded test-only route, or disables a security check:
# DIGEST_TEST_ROUTE=
# METRICS_TEST_ROUTE=
# RETENTION_TEST_ROUTE=
# INTEGRATION_ALLOW_INSECURE_URL=false

# Note: there is no backend-side VAPID_* variable — web push is signed and sent exclusively by
# the frontend server (the VAPID_PRIVATE_KEY/VAPID_SUBJECT above); the backend only stores and
# prunes push_subscriptions rows. See docs/operations/self-hosting.md → "First run" step 1 for
# how this was verified for share-mvp#630.
